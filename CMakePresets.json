{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Visual Studio 18 2026 + vcpkg x64-windows-native",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-native",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
            }
        },
        {
            "name": "compile-commands",
            "displayName": "Ninja, emits compile_commands.json for clangd only (VS preset remains build of record)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-native",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "asan",
            "displayName": "AddressSanitizer (VS generator + MSVC /fsanitize=address)",
            "inherits": ["default"],
            "binaryDir": "${sourceDir}/build-asan",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS_DEBUG": "/Ob0 /Od /Zi /fsanitize=address",
                "CMAKE_EXE_LINKER_FLAGS_DEBUG": "/INCREMENTAL:NO /DEBUG",
                "KESSOKU_ENABLE_ASAN": "ON"
            }
        },
        {
            "name": "pgo-generate",
            "displayName": "PGO training build (/GENPROFILE, release)",
            "inherits": ["default"],
            "binaryDir": "${sourceDir}/build-pgo",
            "cacheVariables": {
                "KESSOKU_PGO": "GENERATE",
                "KESSOKU_PGO_DIR": "${sourceDir}/build-pgo/pgo"
            }
        },
        {
            "name": "pgo-use",
            "displayName": "PGO optimized build (/USEPROFILE, release)",
            "inherits": ["pgo-generate"],
            "cacheVariables": {
                "KESSOKU_PGO": "USE"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "displayName": "Build (Debug)",
            "configurePreset": "default",
            "configuration": "Debug",
            "jobs": 1
        },
        {
            "name": "release",
            "displayName": "Build (Release)",
            "configurePreset": "default",
            "configuration": "Release",
            "jobs": 1
        },
        {
            "name": "compile-commands",
            "displayName": "Build compile_commands.json (Ninja Debug)",
            "configurePreset": "compile-commands",
            "configuration": "Debug",
            "jobs": 1
        },
        {
            "name": "asan",
            "displayName": "Build (ASan Debug)",
            "configurePreset": "asan",
            "configuration": "Debug",
            "jobs": 1
        },
        {
            "name": "pgo-generate",
            "displayName": "Build PGO training app (Release /GENPROFILE)",
            "configurePreset": "pgo-generate",
            "configuration": "Release",
            "jobs": 1
        },
        {
            "name": "pgo-use",
            "displayName": "Build PGO optimized app (Release /USEPROFILE)",
            "configurePreset": "pgo-use",
            "configuration": "Release",
            "jobs": 1
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "displayName": "Test (Debug)",
            "configurePreset": "default",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "timeout": 120
            }
        },
        {
            "name": "release",
            "displayName": "Test (Release)",
            "configurePreset": "default",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "timeout": 120
            }
        },
        {
            "name": "compile-commands",
            "displayName": "Test (Ninja Debug)",
            "configurePreset": "compile-commands",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "timeout": 120
            }
        },
        {
            "name": "asan",
            "displayName": "Test (ASan Debug)",
            "configurePreset": "asan",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "timeout": 120
            }
        },
        {
            "name": "pgo-generate",
            "displayName": "Test (PGO training Release)",
            "configurePreset": "pgo-generate",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "timeout": 120
            }
        },
        {
            "name": "pgo-use",
            "displayName": "Test (PGO optimized Release)",
            "configurePreset": "pgo-use",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "timeout": 120
            }
        }
    ]
}
